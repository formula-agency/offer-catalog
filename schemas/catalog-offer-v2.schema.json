{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formula.example/schemas/catalog-offer-v2.schema.json",
  "title": "Catalog offer queue payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project", "district", "layout", "rooms", "area", "price",
    "finishing", "gifts", "validUntil", "source", "imageUrl", "options",
    "schemaVersion", "imageRevision", "sourceReview"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
    "project": { "type": ["string", "null"] },
    "district": { "type": ["string", "null"] },
    "layout": { "type": ["string", "null"] },
    "rooms": { "type": ["integer", "null"], "minimum": 0 },
    "area": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "price": { "$ref": "#/$defs/nullableMoney" },
    "finishing": { "enum": ["finished", "pre-finish", "unfinished", "unknown"] },
    "gifts": { "type": "array", "items": { "type": "string" } },
    "validUntil": { "$ref": "#/$defs/nullableDate" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "publishedAt"],
      "properties": {
        "url": { "type": ["string", "null"], "format": "uri" },
        "publishedAt": { "$ref": "#/$defs/date" }
      }
    },
    "imageUrl": { "type": ["string", "null"], "format": "uri" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    },
    "schemaVersion": { "const": 2 },
    "imageRevision": { "type": ["string", "null"] },
    "sourceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasConflict", "reasons"],
      "properties": {
        "hasConflict": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "format": "date" },
    "nullableDate": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "qualifier"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "qualifier": { "enum": ["exact", "from"] }
      }
    },
    "nullableMoney": { "anyOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "confirmed", "validUntil"],
      "properties": {
        "code": {
          "enum": [
            "rate_subsidy", "renovation_gift", "parking_gift", "storage_gift",
            "furniture_gift", "kitchen_gift", "developer_pays_mortgage", "discount"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "confirmed": { "type": "boolean" },
        "validUntil": { "$ref": "#/$defs/nullableDate" }
      }
    },
    "actionValidUntil": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partial_down_payment": { "$ref": "#/$defs/nullableDate" },
        "zero_down_payment": { "$ref": "#/$defs/nullableDate" },
        "down_payment_compensation": { "$ref": "#/$defs/nullableDate" },
        "tranche": { "$ref": "#/$defs/nullableDate" },
        "installment": { "$ref": "#/$defs/nullableDate" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "program", "childrenCount", "financing", "downPaymentType",
        "downPayment", "payment", "price", "rate", "paymentPeriod", "conditions",
        "ratePeriod", "promotions", "actionValidUntil", "compensation", "termYears",
        "bank", "stages", "calculation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "childrenCount": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 5 }, { "type": "null" }] },
        "financing": { "enum": ["mortgage", "tranche", "installment", "cash", "unknown"] },
        "downPaymentType": { "enum": ["zero", "partial", "compensated", "full", "unknown"] },
        "downPayment": { "$ref": "#/$defs/nullableMoney" },
        "payment": { "$ref": "#/$defs/nullableMoney" },
        "price": { "$ref": "#/$defs/nullableMoney" },
        "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "paymentPeriod": { "type": ["string", "null"] },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "ratePeriod": { "type": ["string", "null"] },
        "promotions": { "type": "array", "items": { "$ref": "#/$defs/promotion" } },
        "actionValidUntil": { "$ref": "#/$defs/actionValidUntil" },
        "compensation": { "$ref": "#/$defs/nullableMoney" },
        "termYears": { "type": ["integer", "null"], "minimum": 0 },
        "bank": { "type": ["string", "null"] },
        "stages": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "calculation": { "type": ["object", "null"] }
      }
    }
  }
}
